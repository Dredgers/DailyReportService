# Copy to .env (local) or /etc/dailyreport/.env (the box) and fill in real values.
# Names are flat on purpose; src/DailyReport.Worker/Hosting/SecretEnvironmentVariables.cs maps
# them onto configuration keys. Nothing here is ever committed.

# Postgres, as the read-only report_ro role, through the Supabase session pooler (port 5432).
# Create the role with sql/report_ro.sql in the dashboard first. The project ref is the
# subdomain of SUPABASE_URL in the game repos.
REPORT_DB_CONNECTION=Host=aws-0-eu-west-3.pooler.supabase.com;Port=5432;Database=postgres;Username=report_ro.<project-ref>;Password=<report_ro password>;SSL Mode=Require

# Crosswords' separate puzzle-library project, used only to count the approved-and-unused queue.
# Same values the crosswords server uses (PUZZLE_DB_URL / PUZZLE_DB_KEY in its own .env).
PUZZLE_DB_URL=https://<puzzle-project-ref>.supabase.co
PUZZLE_DB_KEY=

# GoatCounter read-statistics token for makemered.goatcounter.com (Settings → API → new token).
# Set the site's time zone to UTC in GoatCounter so its days match Make Me Red's game day.
GOATCOUNTER_MMR_TOKEN=

# Resend API key. The From domain must be verified in Resend.
RESEND_API_KEY=
REPORT_FROM=report@<verified-domain>
REPORT_FROM_NAME=Daily Report

# Comma-separated recipients.
REPORT_TO=

# Optional overrides of appsettings.json (standard .NET "Section__Key" spelling).
# Report__SendAtLocalTime=07:00
# Report__TimeZone=Europe/Copenhagen
# Report__StateDirectory=/data
# DOTNET_ENVIRONMENT=Production
