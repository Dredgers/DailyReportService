<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests: pure Core, golden files, HttpMessageHandler fakes, and a stub Kestrel server for probes. No Docker needed. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel + WebSockets for the stub servers the probe tests talk to. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DailyReport.Core\DailyReport.Core.csproj" />
    <ProjectReference Include="..\..\src\DailyReport.Infrastructure\DailyReport.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DailyReport.Worker\DailyReport.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golden files are compared byte-for-byte; keep them next to the tests and copy on build. -->
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
